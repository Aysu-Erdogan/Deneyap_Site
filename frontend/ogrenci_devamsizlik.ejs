<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Devamsızlık</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <link rel="stylesheet" href="/css/genel.css">
    <link rel="stylesheet" href="/css/ogrenci_devamsizlik.css">
</head>
<body>

<!-- navbar ejs -->
<%- include("partials/navbar") %>

<div class="container-fluid mt-4 px-4">

    <!-- Geri Butonu -->
    <div class="mb-4">
        <a href="/ogrenci" class="btn btn-outline-secondary geri-btn">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
    </div>

    <div class="row">

        <!-- SOL MENÜ -->
        <div class="col-lg-3 mb-4">
            <div class="card ders-card">
                <div class="card-header">
                    Derslerim
                </div>
                <div class="list-group list-group-flush ders-listesi">
                    <% if (dersler.length === 0) { %>
                        <div class="list-group-item text-muted">Henüz ders atanmamış.</div>
                    <% } else { %>
                        <% dersler.forEach(ders => { %>
                            <a href="/ogrenci_devamsizlik?egitim_id=<%= ders.egitim_id %>"
                               class="list-group-item list-group-item-action <%= aktifEgitimId === ders.egitim_id ? 'active' : '' %>">
                                <%= ders.ders_adi %>
                            </a>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- SAĞ TARAF -->
        <div class="col-lg-9">

            <!-- Öğrenci Bilgileri -->
            <div class="card ogrenci-card dashboard-card">
                <div class="card-header">
                    Öğrenci Bilgileri
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Ad Soyad:</strong> <%= ogrenciInfo.ad %> <%= ogrenciInfo.soyad %></p>
                            <p><strong>Sınıf:</strong> <%= ogrenciInfo.sinif_adi %></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Atölye:</strong> <%= ogrenciInfo.atolye_adi %></p>
                            <p><strong>Eğitmen:</strong> <%= ogrenciInfo.egitmen_adi || 'Atanmamış' %></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alt Kısım -->
            <div class="row dashboard-row">

                <!-- Devamsızlık Tablosu -->
                <div class="col-lg-8">
                    <div class="card dashboard-card">
                        <div class="card-header">
                            Devamsızlık Bilgisi
                        </div>
                        <div class="card-body">
                            <% if (!aktifEgitimId || devamsizliklar.length === 0) { %>
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <p class="mb-0">Veri yok</p>
                                </div>
                            <% } else { %>
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Hafta</th>
                                            <th>Durum</th>
                                            <th>Tarih</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% devamsizliklar.forEach(kayit => { %>
                                            <tr>
                                                <td><%= kayit.hafta_no %></td>
                                                <td class="<%= kayit.durum === 'Geldi' ? 'durum-katildi' :
                                                               kayit.durum === 'Gelmedi' ? 'durum-gelmedi' :
                                                               kayit.durum === 'İzinli' ? 'durum-raporlu' : '' %>">
                                                    <%= kayit.durum %>
                                                </td>
                                                <td><%= new Date(kayit.tarih).toLocaleDateString('tr-TR') %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Grafik -->
                <div class="col-lg-4">
                    <div class="card grafik-card dashboard-card">
                        <div class="card-header">
                            Devamsızlık Grafiği
                        </div>
                        <div class="card-body">
                            <% if (!aktifEgitimId || devamsizliklar.length === 0) { %>
                                <div class="grafik-placeholder">
                                    <i class="bi bi-pie-chart-fill"></i>
                                    <p>Veri yok</p>
                                </div>
                            <% } else { %>
                                <div style="height: 300px; width: 100%; display: flex; justify-content: center; align-items: center;">
                                    <canvas id="devamsizlikChart"></canvas>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

<!-- footer ejs -->
<%- include("partials/footer") %>

<!-- Chart verisi EJS'den JS'e aktarılıyor -->
<% if (aktifEgitimId && devamsizliklar.length > 0) { %>
<script>
    const devamsizlikVerisi = <%- JSON.stringify(devamsizliklar) %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/ogrenci_devamsizlik.js"></script>
<% } %>

</body>
</html>