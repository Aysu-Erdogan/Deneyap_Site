                <div class="card-header">
                    Derslerim
                </div>

                <div class="list-group list-group-flush ders-listesi">

                    <a href="#" class="list-group-item list-group-item-action active">
                        Tasarım ve Üretim
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        Robotik Kodlama
                    </a>
                     <a href="#" class="list-group-item list-group-item-action">
                        Elektronik Programlama ve Nesnelerin İnterneti
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        Yazılım Teknolojileri
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        Yapay Zeka
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        Malzeme Bilimi ve Nanoteknoloji
                    </a>
                     <a href="#" class="list-group-item list-group-item-action">
                        Enerji Teknolojileri
                    </a>
                     <a href="#" class="list-group-item list-group-item-action">
                        Havacılık ve Uzay Teknolojileri
                    </a>
                    
                     <a href="#" class="list-group-item list-group-item-action">
                        Siber Güvenlik
                    </a>
                     <a href="#" class="list-group-item list-group-item-action">
                        Mobil Uygulama
                    </a>


                </div>

            </div>

        </div>

        <!-- SAĞ TARAF -->
        <div class="col-lg-9">

            <!-- Öğrenci Bilgileri -->
            <div class="card ogrenci-card dashboard-card">

                <div class="card-header">
                    Öğrenci Bilgileri
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6">

                            <p><strong>Ad Soyad:</strong> Aysu Erdoğan</p>
                            <p><strong>Sınıf:</strong> F Sınıfı</p>

                        </div>

                        <div class="col-md-6">

                            <p><strong>Atölye:</strong> Ardahan Deneyap</p>
                            <p><strong>Eğitmen:</strong> Ahmet Yılmaz</p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Alt Kısım -->
            <div class="row dashboard-row">

                <!-- Devamsızlık -->
                <div class="col-lg-8">

                    <div class="card dashboard-card">

                        <div class="card-header">
                            Devamsızlık Bilgisi
                        </div>

                        <div class="card-body">

                            <table class="table table-hover align-middle">

                                <thead>

                                    <tr>
                                        <th>Hafta</th>
                                        <th>Durum</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    <tr>
                                        <td>1</td>
                                        <td class="durum-katildi">Katıldı</td>
                                    </tr>

                                    <tr>
                                        <td>2</td>
                                        <td class="durum-gelmedi">Gelmedi</td>
                                    </tr>

                                    <tr>
                                        <td>3</td>
                                        <td class="durum-katildi">Katıldı</td>
                                    </tr>

                                    <tr>
                                        <td>4</td>
                                        <td class="durum-raporlu">Raporlu</td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

                <!-- Grafik -->
                <div class="col-lg-4">

                    <div class="card grafik-card dashboard-card">

                        <div class="card-header">
                            Devamsızlık Grafiği
                        </div>

                        <div class="card-body grafik-placeholder">

                            <i class="bi bi-pie-chart-fill"></i>

                            <p>Grafik burada görüntülenecek.</p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- footer ejs -->
<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/ogrenci_devamsizlik.js"></script>

