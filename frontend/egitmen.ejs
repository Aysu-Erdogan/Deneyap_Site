
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eğitmen Paneli</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&amp;display=swap" />
    <link rel="stylesheet" href="/css/genel.css">
    <link rel="stylesheet" href="/css/egitmen.css">
</head>
<body class="egitmen-body">

<%- include("partials/navbar") %>

<div class="egitmen-page-wrap">

    <aside class="teacher-sidebar">
        
        <ul class="sidebar-nav" id="teacherNav">
            <li>
                <a href="#devamsizliklar" data-card="devamsizliklarCard">
                    <span class="bi bi-calendar-x"></span>
                    <span class="nav-text">Devamsızlıklar</span>
                </a>
            </li>
            <li>
                <a href="#egitim-icerikleri" data-card="egitimIcerikleriCard">
                    <span class="bi bi-book"></span>
                    <span class="nav-text">Eğitim İçerikleri</span>
                </a>
            </li>
            <li>
                <a href="#bilgi-bankasi" data-card="bilgiBankasiCard">
                    <span class="bi bi-lightbulb"></span>
                    <span class="nav-text">Bilgi Bankası</span>
                </a>
            </li>
            <li>
                <a href="#ogrenciler" data-card="ogrencilerCard">
                    <span class="bi bi-people"></span>
                    <span class="nav-text">Öğrenciler</span>
                </a>
            </li>
            <li>
                <a href="#profil" data-card="profilCard">
                    <span class="bi bi-person-circle"></span>
                    <span class="nav-text">Profilim</span>
                </a>
            </li>
        </ul>
    </aside>

    <main class="teacher-main">
        <div class="page-header">
            <h1>Hoş geldiniz, <%= egitmenAd %></h1>
            <p>Eğitmen paneli</p>
        </div>

        
        <!-- Dashboard Kartı -->
        <div id="dashboardCard" class="teacher-card">
            <div class="dashboard-hero">
                <div class="dot-pattern"></div>
                <div class="hero-content">
                    <h1 class="hero-title">
                        <span class="highlight-blue">Öğret.</span> Üret.<br>
                        Paylaş. <span class="highlight-orange">İlham Ol.</span>
                    </h1>
                    <p class="hero-subtitle">Milli Teknoloji Hamlesi'nin bir parçası ol.</p>
                </div>
            </div>
            
            <div class="row g-4 mt-2">
                <div class="col-md-4">
                    <div class="dashboard-stat-card">
                        <div class="stat-icon blue-icon"><i class="bi bi-clipboard-check"></i></div>
                        <div class="stat-info">
                            <h3 id="stat-yoklama">0</h3>
                            <p>Bekleyen Yoklama</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="dashboard-stat-card">
                        <div class="stat-icon orange-icon"><i class="bi bi-camera-video"></i></div>
                        <div class="stat-info">
                            <h3 id="stat-egitim">0</h3>
                            <p>Yeni Eğitim İçeriği</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="dashboard-stat-card">
                        <div class="stat-icon green-icon"><i class="bi bi-file-earmark-text"></i></div>
                        <div class="stat-info">
                            <h3 id="stat-bilgi">0</h3>
                            <p>Yeni Bilgi Bankası</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        
        <!-- Devamsızlıklar Kartı -->
        <div id="devamsizliklarCard" class="teacher-card" style="display:none;">
            <div id="sinifListesiGorunumu">
                <div class="card-header border-0 pb-0">
                    <div>
                        <h3 class="mb-1">Sınıflarım</h3>
                        <p class="text-secondary text-sm">Size atanan sınıflar ve dersler</p>
                    </div>
                </div>
                <!-- Sinif Kartlari Buraya Gelecek -->
                <div id="sinifKartlariContainer" class="row g-4 mt-2">
                    <div class="col-12 text-center py-5 text-secondary">
                        <div class="spinner-border spinner-border-sm" role="status"></div> Sınıflar Yükleniyor...
                    </div>
                </div>
            </div>

            <!-- Yoklama Ekranı (Varsayılan olarak gizli) -->
            <div id="yoklamaEkraniGorunumu" style="display:none;">
                <div class="d-flex align-items-center mb-4">
                    <button class="btn btn-secondary btn-sm me-3" id="btnYoklamaGeri">
                        <i class="bi bi-arrow-left"></i> Sınıflara Dön
                    </button>
                    <div>
                        <h3 class="mb-0" id="yoklamaSinifAdi">Sınıf Adı</h3>
                        <p class="text-secondary mb-0" id="yoklamaDersAdi">Ders Adı</p>
                    </div>
                </div>

                <div class="card bg-light border-0 mb-4">
                    <div class="card-body">
                        <label class="form-label fw-bold">Yoklama Tarihi Seçin</label>
                        <select class="form-select w-auto min-w-200" id="yoklamaTarihSelect">
                            <option value="">Tarih Yükleniyor...</option>
                        </select>
                        <small class="text-secondary mt-2 d-block">Sadece geçerli ders tarihleri seçilebilir.</small>
                    </div>
                </div>

                <div id="yoklamaTabloContainer" style="display:none;">
                    <div class="table-responsive">
                        <table class="table align-middle teacher-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Ad Soyad</th>
                                    <th>Derse Katıldı mı?</th>
                                    <th>Geç Kalma / Erken Çıkma Sebebi</th>
                                </tr>
                            </thead>
                            <tbody id="yoklamaOgrenciListesi">
                                <!-- Ogrenciler buraya -->
                            </tbody>
                        </table>
                    </div>
                    
                    <div id="yoklamaMesaj" class="alert mt-3" style="display:none;"></div>

                    <div class="text-end mt-4">
                        <button class="btn btn-egitmen-kaydet px-4 py-2" id="btnYoklamaKaydet">
                            <i class="bi bi-check2-circle me-2"></i> Yoklamayı Kaydet
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- Eğitim İçerikleri -->
        <div id="egitimIcerikleriCard" class="teacher-card" style="display:none;">
            <div class="card-header">
                <h3>Eğitim İçerikleri</h3>
                <a href="#" class="btn btn-info btn-sm">Yönet</a>
            </div>
            <div class="empty-state">
                <div><i class="bi bi-folder fs-1 opacity-50"></i></div>
                <h5>Henüz içerik yok</h5>
                <p>Yeni eğitim içeriği eklemek için butonları kullanın.</p>
            </div>
        </div>

        <!-- Bilgi Bankası -->
        <div id="bilgiBankasiCard" class="teacher-card" style="display:none;">
            <div class="card-header">
                <h3>Bilgi Bankası</h3>
                <a href="#" class="btn btn-info btn-sm">Görüntüle</a>
            </div>
            <div class="empty-state">
                <div><i class="bi bi-folder-fill fs-1 opacity-50"></i></div>
                <h5>Henüz belge yok</h5>
                <p>Yeni bilgi bankası kaydı eklemek için butonları kullanın.</p>
            </div>
        </div>

        <!-- Öğrenciler -->
        <div id="ogrencilerCard" class="teacher-card" style="display:none;">
            <div class="card-header">
                <h3>Öğrenci Listesi</h3>
                <a href="#" class="btn btn-info btn-sm">Yeni Öğrenci</a>
            </div>
            <div class="table-responsive">
                <table class="teacher-table">
                    <thead>
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Email</th>
                            <th>Sınıf</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Yeni veri yok</td>
                            <td colspan="3" class="text-center">Kayıtlı öğrenci bulunmuyor</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Profil Kartı -->
        <div id="profilCard" class="teacher-card" style="display:none;">
            <div class="card-header">
                <h3><i class="bi bi-person-circle me-2"></i>Profilim</h3>
            </div>

            <!-- Görünüm modu -->
            <div id="profilBilgileri">
                <div class="profil-avatar-row mb-4">
                    <div class="profil-avatar"><i class="bi bi-person-fill"></i></div>
                    <div class="profil-meta">
                        <h5 id="profil-ad-soyad" class="mb-1">Yükleniyor...</h5>
                        <span class="profil-rol-badge">Eğitmen</span>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="profil-label">Ad Soyad</label>
                        <div class="profil-value" id="profil-ad-soyad-text">—</div>
                    </div>
                    <div class="col-md-6">
                        <label class="profil-label">E-posta</label>
                        <div class="profil-value" id="profil-email-text">—</div>
                    </div>
                    <div class="col-md-6">
                        <label class="profil-label">Telefon</label>
                        <div class="profil-value" id="profil-telefon-text">—</div>
                    </div>
                </div>
                <button class="btn btn-egitmen-duzenle" id="profilDuzenleBtn">
                    <i class="bi bi-pencil-square me-1"></i> Bilgileri Düzenle
                </button>
            </div>

            <!-- Düzenleme formu -->
            <div id="profilDuzenleForm" style="display:none;">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Ad</label>
                        <input type="text" class="form-control" id="edit-ad">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Soyad</label>
                        <input type="text" class="form-control" id="edit-soyad">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">E-posta</label>
                        <input type="email" class="form-control" id="edit-email">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Telefon</label>
                        <input type="text" class="form-control" id="edit-telefon">
                    </div>
                </div>
                <div id="profilMesaj" class="alert" style="display:none;" role="alert"></div>
                <div class="d-flex gap-2">
                    <button class="btn btn-egitmen-kaydet" id="profilKaydetBtn">
                        <i class="bi bi-check2 me-1"></i> Değişiklikleri Kaydet
                    </button>
                    <button class="btn btn-egitmen-iptal" id="profilIptalBtn">İptal</button>
                </div>
            </div>
        </div>

    </main>
</div>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/egitmen.js"></script>
</body>
</html>
