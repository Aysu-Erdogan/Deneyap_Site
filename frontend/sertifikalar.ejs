<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sertifikalar</title>

    <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
/>

<link rel="stylesheet" href="/css/genel.css" />
<link rel="stylesheet" href="/css/ogrenci_devamsizlik.css" />
<link rel="stylesheet" href="/css/sertifikalar.css" />

<script src="/js/sertifikalar.js" defer></script>


  </head>

  <body>
    <%- include("partials/navbar") %>
    <div class="container" style="margin-top: 20px">
      <div class="mb-4">
        <a href="/ogrenci" class="btn btn-outline-secondary geri-btn">
          <i class="bi bi-arrow-left"></i> Geri
        </a>
      </div>

<section class="certificate-section container py-5">

    <h2 class="text-center mb-5 fw-bold">
        Sertifikalarım
    </h2>

    <div class="coverflow">

        <button class="cover-btn prev">
            
        </button>

        <div class="coverflow-track" id="coverflowTrack">

            <!-- Kart 1 -->
            <div class="certificate-card" data-index="0">

                <div class="card-image">
                    <img src="images/python.jpg" alt="">
                </div>

                <div class="card-content">



                    <h3>Yapay Zeka</h3>

                    <p>
                        Temel Python Programlama
                    </p>

                    <div class="card-info">

                        <span> 12.07.2026</span>


                    </div>

                    <button class="btn btn-primary mt-3">
                        Sertifikayı Gör
                    </button>

                </div>

            </div>

            <!-- Kart 2 -->
            <div class="certificate-card" data-index="1">

                <div class="card-image">
                    <img src="images/web.jpg" alt="">
                </div>

                <div class="card-content">



                    <h3>Enerji Teknolojileri</h3>

                    <p>
                        Temel enerji teknolojileri
                    </p>

                    <div class="card-info">

                        <span> 20.07.2026</span>



                    </div>

                    <button class="btn btn-primary mt-3">
                        Sertifikayı Gör
                    </button>

                </div>

            </div>

            <!-- Kart 3 -->
            <div class="certificate-card" data-index="2">

                <div class="card-image">
                    <img src="images/robotik.jpg" alt="">
                </div>

                <div class="card-content">



                    <h3>Robotik Kodlama</h3>

                    <p>
                        Arduino ve Sensörler
                    </p>

                    <div class="card-info">

                        <span> 01.08.2026</span>


                    </div>

                    <button class="btn btn-primary mt-3">
                        Sertifikayı Gör
                    </button>

                </div>

            </div>

                        <!-- Kart 4 -->
            <div class="certificate-card" data-index="3">

                <div class="card-image">
                    <img src="images/python.jpg" alt="">
                </div>

                <div class="card-content">



                    <h3>Yazılım Teknoolojileri</h3>

                    <p>
                        Temel C++ Programlama
                    </p>

                    <div class="card-info">

                        <span> 12.07.2026</span>


                    </div>

                    <button class="btn btn-primary mt-3">
                        Sertifikayı Gör
                    </button>

                </div>

            </div>

        </div>

        <button class="cover-btn next">
            ❯
        </button>

    </div>

    <div class="coverflow-dots">
        <span class="dot active"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
    </div>

</section>

    </div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <%- include("partials/footer") %>


  </body>
</html>
