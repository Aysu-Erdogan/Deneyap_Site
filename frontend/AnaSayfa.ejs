<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Deneyap Bilgi Sistemi</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <link rel="stylesheet" href="AnaSayfa.css">
    <link rel="stylesheet" href="/css/genel.css">

  </head>
  <body>

    <%- include("partials/navbar") %>



    <!-- ana konteyner -->
    <div class="container-fluid mt-4 px-4">
      <div class="row">

        
        <!-- Left Column: Carousel -->
        <div class="col-lg-8 mb-4">
          <!-- Carousel -->
          <div
            id="demo"
            class="carousel slide rounded shadow-sm overflow-hidden"
            data-bs-ride="carousel"
          >
            <!-- Indicators/dots -->
            <div class="carousel-indicators">
              <button
                type="button"
                data-bs-target="#demo"
                data-bs-slide-to="0"
                class="active"
              ></button>
              <button
                type="button"
                data-bs-target="#demo"
                data-bs-slide-to="1"
              ></button>
              <button
                type="button"
                data-bs-target="#demo"
                data-bs-slide-to="2"
              ></button>
            </div>

            <!-- The slideshow/carousel -->
            <div class="carousel-inner">
              <div class="carousel-item active">
                <img
                  src="resimlersite/anasayfafoto1.jpg"
                  alt="Deneyap Foto 1"
                  class="d-block w-100"
                  style="object-fit: cover; height: 500px"
                />
                <div
                  class="carousel-caption d-none d-md-block"
                  style="
                    background: rgba(0, 0, 0, 0.5);
                    border-radius: 10px;
                    padding: 15px 20px;
                    bottom: 30px;
                  "
                >
                  <h3 class="fw-bold">Deneyap Türkiye</h3>
                  <p>Geleceğin teknoloji liderleri burada yetişiyor.</p>
                </div>
              </div>
              <div class="carousel-item">
                <img
                  src="resimlersite/anasayfafoto2.jpg"
                  alt="Deneyap Foto 2"
                  class="d-block w-100"
                  style="object-fit: cover; height: 500px"
                />
                <div
                  class="carousel-caption d-none d-md-block"
                  style="
                    background: rgba(0, 0, 0, 0.5);
                    border-radius: 10px;
                    padding: 15px 20px;
                    bottom: 30px;
                  "
                >
                  <h3 class="fw-bold">Eğitim & Teknoloji</h3>
                  <p>Proje tabanlı öğrenme ile fark yarat.</p>
                </div>
              </div>
              <div class="carousel-item">
                <img
                  src="resimlersite/anasayfafoto3.jpg"
                  alt="Deneyap Foto 3"
                  class="d-block w-100"
                  style="object-fit: cover; height: 500px"
                />
                <div
                  class="carousel-caption d-none d-md-block"
                  style="
                    background: rgba(0, 0, 0, 0.5);
                    border-radius: 10px;
                    padding: 15px 20px;
                    bottom: 30px;
                  "
                >
                  <h3 class="fw-bold">Geleceğe Hazırla</h3>
                  <p>Bilim, teknoloji, mühendislik ve matematik.</p>
                </div>
              </div>
            </div>

            <!-- Left and right controls/icons -->
            <button
              class="carousel-control-prev"
              type="button"
              data-bs-target="#demo"
              data-bs-slide="prev"
            >
              <span class="carousel-control-prev-icon"></span>
            </button>
            <button
              class="carousel-control-next"
              type="button"
              data-bs-target="#demo"
              data-bs-slide="next"
            >
              <span class="carousel-control-next-icon"></span>
            </button>
          </div>
        </div>

        <!-- sağ konteynır  -->
        <div class="col-lg-4 d-flex align-items-center">
          <div class="row g-3 w-100">



            <!-- Öğrenci Girişi -->
            <div class="col-sm-6">
              <a href="/ogrenci" class="text-decoration-none">
                <div
                  class="card text-white text-center h-100 shadow border-0"
                  style="background-color: #f39c12; transition: transform 0.2s"
                  onmouseover="this.style.transform = 'scale(1.05)'"
                  onmouseout="this.style.transform = 'scale(1)'"
                >
                  <div class="card-body py-4">
                    <i
                      class="bi bi-mortarboard-fill display-4 mb-3 d-block"
                    ></i>
                    <h5 class="card-title fw-bold">Öğrenci Girişi</h5>
                  </div>
                </div>
              </a>
            </div>



            <!-- Veli Girişi -->
            <div class="col-sm-6">
              <a href="/veli" class="text-decoration-none">
                <div
                  class="card text-white text-center h-100 shadow border-0"
                  style="background-color: #e74c3c; transition: transform 0.2s"
                  onmouseover="this.style.transform = 'scale(1.05)'"
                  onmouseout="this.style.transform = 'scale(1)'"
                >
                  <div class="card-body py-4">
                    <i class="bi bi-people-fill display-4 mb-3 d-block"></i>
                    <h5 class="card-title fw-bold">Veli Girişi</h5>
                  </div>
                </div>
              </a>
            </div>



            <!-- Eğitmen Girişi -->
            <div class="col-sm-6">
              <a href="/egitmen" class="text-decoration-none">
                <div
                  class="card text-white text-center h-100 shadow border-0"
                  style="background-color: #e84393; transition: transform 0.2s"
                  onmouseover="this.style.transform = 'scale(1.05)'"
                  onmouseout="this.style.transform = 'scale(1)'"
                >
                  <div class="card-body py-4">
                    <i
                      class="bi bi-person-workspace display-4 mb-3 d-block"
                    ></i>
                    <h5 class="card-title fw-bold">Eğitmen Girişi</h5>
                  </div>
                </div>
              </a>
            </div>




            <!-- Yönetici Girişi -->
            <div class="col-sm-6">
              <a href="/yonetici" class="text-decoration-none">
                <div
                  class="card text-white text-center h-100 shadow border-0"
                  style="background-color: #9b59b6; transition: transform 0.2s"
                  onmouseover="this.style.transform = 'scale(1.05)'"
                  onmouseout="this.style.transform = 'scale(1)'"
                >
                  <div class="card-body py-4">
                    <i
                      class="bi bi-shield-lock-fill display-4 mb-3 d-block"
                    ></i>
                    <h5 class="card-title fw-bold">Yönetici Girişi</h5>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

<%- include("partials/footer") %>






  </body>
</html>
